<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BibliotecaApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:BibliotecaApp.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.BackgroundColor="#1E40AF"
    Shell.ForegroundColor="White"
    Shell.TitleColor="White"
    Shell.TabBarBackgroundColor="White"
    Shell.TabBarTitleColor="#1E40AF"
    Shell.TabBarUnselectedColor="#64748B"
    Title="BibliotecaApp">

    <ShellContent Route="login"
                  Shell.NavBarIsVisible="False"
                  ContentTemplate="{DataTemplate views:LoginPage}" />

    <TabBar Route="principal">
        <ShellContent Title="Libros"    Route="libros"    ContentTemplate="{DataTemplate views:LibrosPage}" />
        <ShellContent Title="Usuarios"  Route="usuarios"  ContentTemplate="{DataTemplate views:UsuariosPage}" />
        <ShellContent Title="Préstamos" Route="prestamos" ContentTemplate="{DataTemplate views:PrestamosPage}" />
        <ShellContent Title="Reportes"  Route="reportes"  ContentTemplate="{DataTemplate views:ReportesPage}" />
    </TabBar>

</Shell>
